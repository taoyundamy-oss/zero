# Zero Cloud 环境配置 — 复制为 .env 后填写
# 生成 Token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

ZERO_CLOUD_TOKEN=CHANGE_ME
# Independent SearXNG secret, generated by scripts/prepare_env.py
SEARXNG_SECRET=
# Only for the retired profile; generating a key does not enable that profile.
NAPCAT_WEBUI_TOKEN=

# 可选：配置代理后自动启用 Google 等被墙引擎
# PROXY_URL=http://127.0.0.1:7890
